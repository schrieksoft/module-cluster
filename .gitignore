# ---- Terraform ----

# Local .terraform directories
**/.terraform/*
**/.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
*.tfvars.json
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan file
*.plan

# CLI config (contains credentials!)
.terraformrc
terraform.rc

# Module directories (if you're using local modules)
# Uncomment if you vendor modules:
# modules/

